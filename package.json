  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tauri-apps/cli": "2.12.4",
    "playwright": "1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
